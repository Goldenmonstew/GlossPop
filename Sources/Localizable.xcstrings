    "Select a Vocabulary Entry": {
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Wortschatzeintrag auswählen"}},
        "es": {"stringUnit": {"state": "translated", "value": "Selecciona una entrada de vocabulario"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Sélectionnez une entrée de vocabulaire"}},
        "ja": {"stringUnit": {"state": "translated", "value": "単語帳の項目を選択"}},
        "ko": {"stringUnit": {"state": "translated", "value": "단어장 항목 선택"}},
        "ru": {"stringUnit": {"state": "translated", "value": "Выберите запись словаря"}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "选择生词条目"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "選取生詞項目"}}
      }
    },
    "Select a word or phrase, then use the bookmark in its result card.": {
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Wähle ein Wort oder eine Wendung aus und verwende dann das Lesezeichen in der Ergebniskarte."}},
        "es": {"stringUnit": {"state": "translated", "value": "Selecciona una palabra o frase y usa el marcador de su ficha de resultado."}},
        "fr": {"stringUnit": {"state": "translated", "value": "Sélectionnez un mot ou une expression, puis utilisez le signet de sa fiche de résultat."}},
        "ja": {"stringUnit": {"state": "translated", "value": "単語または語句を選択し、結果カードのブックマークを使って保存します。"}},
        "ko": {"stringUnit": {"state": "translated", "value": "단어나 구문을 선택한 다음 결과 카드의 책갈피를 사용하세요."}},
        "ru": {"stringUnit": {"state": "translated", "value": "Выделите слово или фразу, затем нажмите закладку в карточке результата."}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "选择单词或短语，然后点击结果卡片中的书签。"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "選取單字或片語，然後點按結果卡片中的書籤。"}}
      }
    },
    "Show All Languages": {
      "localizations": {
