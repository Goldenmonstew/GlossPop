    "A damaged vocabulary file was preserved and a new library was started.": {
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Eine beschädigte Wortschatzdatei wurde gesichert und eine neue Sammlung angelegt."}},
        "es": {"stringUnit": {"state": "translated", "value": "Se conservó un archivo de vocabulario dañado y se creó una biblioteca nueva."}},
        "fr": {"stringUnit": {"state": "translated", "value": "Le fichier de vocabulaire endommagé a été conservé et une nouvelle bibliothèque a été créée."}},
        "ja": {"stringUnit": {"state": "translated", "value": "破損した単語帳ファイルを保存し、新しい単語帳を作成しました。"}},
        "ko": {"stringUnit": {"state": "translated", "value": "손상된 단어장 파일을 보존하고 새 단어장을 시작했습니다."}},
        "ru": {"stringUnit": {"state": "translated", "value": "Повреждённый файл словаря сохранён, создана новая библиотека."}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "已保留损坏的生词本文件，并创建了新的生词本。"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "已保留損毀的生詞本檔案，並建立新的生詞本。"}}
      }
    },
    "A vocabulary entry needs a term.": {
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Ein Wortschatzeintrag benötigt einen Begriff."}},
        "es": {"stringUnit": {"state": "translated", "value": "Una entrada de vocabulario necesita un término."}},
        "fr": {"stringUnit": {"state": "translated", "value": "Une entrée de vocabulaire doit contenir un terme."}},
        "ja": {"stringUnit": {"state": "translated", "value": "単語帳の項目には語句が必要です。"}},
        "ko": {"stringUnit": {"state": "translated", "value": "단어장 항목에는 단어나 구문이 필요합니다."}},
        "ru": {"stringUnit": {"state": "translated", "value": "Для записи в словаре требуется термин."}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "生词本条目需要填写词语。"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "生詞本項目需要填寫詞語。"}}
      }
    },
    "A vocabulary entry needs both source and target languages.": {
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Ein Wortschatzeintrag benötigt eine Ausgangs- und eine Zielsprache."}},
        "es": {"stringUnit": {"state": "translated", "value": "Una entrada de vocabulario necesita los idiomas de origen y destino."}},
        "fr": {"stringUnit": {"state": "translated", "value": "Une entrée de vocabulaire doit indiquer les langues source et cible."}},
        "ja": {"stringUnit": {"state": "translated", "value": "単語帳の項目には原文と訳文の両方の言語が必要です。"}},
        "ko": {"stringUnit": {"state": "translated", "value": "단어장 항목에는 원본 언어와 대상 언어가 모두 필요합니다."}},
        "ru": {"stringUnit": {"state": "translated", "value": "Для записи в словаре нужны исходный и целевой языки."}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "生词本条目需要同时指定源语言和目标语言。"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "生詞本項目需要同時指定來源語言和目標語言。"}}
      }
    },
    "A vocabulary entry needs dictionary content.": {
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Ein Wortschatzeintrag benötigt Wörterbuchinhalt."}},
        "es": {"stringUnit": {"state": "translated", "value": "Una entrada de vocabulario necesita contenido de diccionario."}},
        "fr": {"stringUnit": {"state": "translated", "value": "Une entrée de vocabulaire doit contenir des données de dictionnaire."}},
        "ja": {"stringUnit": {"state": "translated", "value": "単語帳の項目には辞書の内容が必要です。"}},
        "ko": {"stringUnit": {"state": "translated", "value": "단어장 항목에는 사전 내용이 필요합니다."}},
        "ru": {"stringUnit": {"state": "translated", "value": "Для записи в словаре требуется словарное содержимое."}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "生词本条目需要包含词典内容。"}},
