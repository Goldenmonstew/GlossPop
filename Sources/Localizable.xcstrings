        "zh-Hans": {"stringUnit": {"state": "translated", "value": "系统词典"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "系統辭典"}}
      }
    },
    "The damaged vocabulary file could not be preserved. Saving is blocked.": {
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Die beschädigte Wortschatzdatei konnte nicht gesichert werden. Speichern ist blockiert."}},
        "es": {"stringUnit": {"state": "translated", "value": "No se pudo conservar el archivo de vocabulario dañado. El guardado está bloqueado."}},
        "fr": {"stringUnit": {"state": "translated", "value": "Le fichier de vocabulaire endommagé n’a pas pu être conservé. L’enregistrement est bloqué."}},
        "ja": {"stringUnit": {"state": "translated", "value": "破損した単語帳ファイルを保存できませんでした。保存は無効になっています。"}},
        "ko": {"stringUnit": {"state": "translated", "value": "손상된 단어장 파일을 보존할 수 없습니다. 저장이 차단되었습니다."}},
        "ru": {"stringUnit": {"state": "translated", "value": "Не удалось сохранить повреждённый файл словаря. Сохранение заблокировано."}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "无法保留损坏的生词本文件。保存功能已停用。"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "無法保留損毀的生詞本檔案。儲存功能已停用。"}}
      }
    },
    "The damaged vocabulary library could not be preserved.": {
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Der beschädigte Wortschatz konnte nicht gesichert werden."}},
        "es": {"stringUnit": {"state": "translated", "value": "No se pudo conservar la biblioteca de vocabulario dañada."}},
        "fr": {"stringUnit": {"state": "translated", "value": "La bibliothèque de vocabulaire endommagée n’a pas pu être conservée."}},
        "ja": {"stringUnit": {"state": "translated", "value": "破損した単語帳を保存できませんでした。"}},
        "ko": {"stringUnit": {"state": "translated", "value": "손상된 단어장을 보존할 수 없습니다."}},
        "ru": {"stringUnit": {"state": "translated", "value": "Не удалось сохранить повреждённый словарь."}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "无法保留损坏的生词本。"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "無法保留損毀的生詞本。"}}
      }
    },
    "The exported file could not be verified.": {
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Die exportierte Datei konnte nicht überprüft werden."}},
        "es": {"stringUnit": {"state": "translated", "value": "No se pudo verificar el archivo exportado."}},
        "fr": {"stringUnit": {"state": "translated", "value": "Impossible de vérifier le fichier exporté."}},
        "ja": {"stringUnit": {"state": "translated", "value": "書き出したファイルを検証できませんでした。"}},
        "ko": {"stringUnit": {"state": "translated", "value": "내보낸 파일을 확인할 수 없습니다."}},
        "ru": {"stringUnit": {"state": "translated", "value": "Не удалось проверить экспортированный файл."}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "无法验证导出的文件。"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "無法驗證匯出的檔案。"}}
      }
    },
    "The previous clipboard contents could not be restored.": {
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Der vorherige Inhalt der Zwischenablage konnte nicht wiederhergestellt werden."}},
        "es": {"stringUnit": {"state": "translated", "value": "No se pudo restaurar el contenido anterior del portapapeles."}},
        "fr": {"stringUnit": {"state": "translated", "value": "Impossible de restaurer le contenu précédent du presse-papiers."}},
        "ja": {"stringUnit": {"state": "translated", "value": "以前のクリップボードの内容を復元できませんでした。"}},
        "ko": {"stringUnit": {"state": "translated", "value": "이전 클립보드 내용을 복원할 수 없습니다."}},
        "ru": {"stringUnit": {"state": "translated", "value": "Не удалось восстановить предыдущее содержимое буфера обмена."}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "无法恢复先前的剪贴板内容。"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "無法復原先前的剪貼簿內容。"}}
      }
    },
    "The result could not be copied.": {
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Das Ergebnis konnte nicht kopiert werden."}},
        "es": {"stringUnit": {"state": "translated", "value": "No se pudo copiar el resultado."}},
        "fr": {"stringUnit": {"state": "translated", "value": "Impossible de copier le résultat."}},
        "ja": {"stringUnit": {"state": "translated", "value": "結果をコピーできませんでした。"}},
        "ko": {"stringUnit": {"state": "translated", "value": "결과를 복사할 수 없습니다."}},
        "ru": {"stringUnit": {"state": "translated", "value": "Не удалось скопировать результат."}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "无法拷贝结果。"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "無法拷貝結果。"}}
      }
    },
    "The vocabulary file cannot be read. It has not been changed.": {
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Die Wortschatzdatei kann nicht gelesen werden. Sie wurde nicht geändert."}},
        "es": {"stringUnit": {"state": "translated", "value": "No se puede leer el archivo de vocabulario. No se ha modificado."}},
        "fr": {"stringUnit": {"state": "translated", "value": "Le fichier de vocabulaire est illisible. Il n’a pas été modifié."}},
        "ja": {"stringUnit": {"state": "translated", "value": "単語帳ファイルを読み込めません。ファイルは変更されていません。"}},
        "ko": {"stringUnit": {"state": "translated", "value": "단어장 파일을 읽을 수 없습니다. 파일은 변경되지 않았습니다."}},
        "ru": {"stringUnit": {"state": "translated", "value": "Не удаётся прочитать файл словаря. Файл не изменён."}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "无法读取生词本文件。文件未被更改。"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "無法讀取生詞本檔案。檔案未被更改。"}}
      }
    },
    "The vocabulary library cannot be read.": {
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Der Wortschatz kann nicht gelesen werden."}},
        "es": {"stringUnit": {"state": "translated", "value": "No se puede leer la biblioteca de vocabulario."}},
        "fr": {"stringUnit": {"state": "translated", "value": "La bibliothèque de vocabulaire est illisible."}},
        "ja": {"stringUnit": {"state": "translated", "value": "単語帳を読み込めません。"}},
        "ko": {"stringUnit": {"state": "translated", "value": "단어장을 읽을 수 없습니다."}},
        "ru": {"stringUnit": {"state": "translated", "value": "Не удаётся прочитать словарь."}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "无法读取生词本。"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "無法讀取生詞本。"}}
      }
    },
    "This cannot be undone. Preserved recovery backups are not deleted.": {
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Dies kann nicht rückgängig gemacht werden. Gesicherte Wiederherstellungsdateien werden nicht gelöscht."}},
        "es": {"stringUnit": {"state": "translated", "value": "Esta acción no se puede deshacer. Las copias de recuperación conservadas no se eliminan."}},
        "fr": {"stringUnit": {"state": "translated", "value": "Cette action est irréversible. Les sauvegardes de récupération conservées ne sont pas supprimées."}},
        "ja": {"stringUnit": {"state": "translated", "value": "この操作は取り消せません。保存された復旧用バックアップは削除されません。"}},
        "ko": {"stringUnit": {"state": "translated", "value": "이 작업은 실행 취소할 수 없습니다. 보존된 복구 백업은 삭제되지 않습니다."}},
        "ru": {"stringUnit": {"state": "translated", "value": "Это действие нельзя отменить. Сохранённые резервные копии восстановления не удаляются."}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "此操作无法撤销。已保留的恢复备份不会被删除。"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "此操作無法還原。已保留的復原備份不會被刪除。"}}
      }
    },
    "This removes the saved entry from this Mac.": {
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Dadurch wird der gespeicherte Eintrag von diesem Mac entfernt."}},
        "es": {"stringUnit": {"state": "translated", "value": "Esto elimina la entrada guardada de este Mac."}},
        "fr": {"stringUnit": {"state": "translated", "value": "L’entrée enregistrée sera supprimée de ce Mac."}},
        "ja": {"stringUnit": {"state": "translated", "value": "保存した項目がこのMacから削除されます。"}},
        "ko": {"stringUnit": {"state": "translated", "value": "저장된 항목이 이 Mac에서 제거됩니다."}},
        "ru": {"stringUnit": {"state": "translated", "value": "Сохранённая запись будет удалена с этого Mac."}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "这会从这台 Mac 移除已保存的条目。"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "這會從這部 Mac 移除已儲存的項目。"}}
      }
    },
    "This vocabulary file uses unsupported version %lld. It has not been changed.": {
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Diese Wortschatzdatei verwendet die nicht unterstützte Version %lld. Sie wurde nicht geändert."}},
        "es": {"stringUnit": {"state": "translated", "value": "Este archivo de vocabulario usa la versión no compatible %lld. No se ha modificado."}},
        "fr": {"stringUnit": {"state": "translated", "value": "Ce fichier de vocabulaire utilise la version %lld, qui n’est pas prise en charge. Il n’a pas été modifié."}},
        "ja": {"stringUnit": {"state": "translated", "value": "この単語帳ファイルは未対応のバージョン%lldを使用しています。ファイルは変更されていません。"}},
        "ko": {"stringUnit": {"state": "translated", "value": "이 단어장 파일은 지원되지 않는 버전 %lld을(를) 사용합니다. 파일은 변경되지 않았습니다."}},
        "ru": {"stringUnit": {"state": "translated", "value": "Файл словаря имеет неподдерживаемую версию %lld. Файл не изменён."}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "此生词本文件使用不受支持的版本 %lld。文件未被更改。"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "此生詞本檔案使用不支援的版本 %lld。檔案未被更改。"}}
      }
    },
    "Unavailable": {
      "localizations": {
