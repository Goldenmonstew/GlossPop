        "ja": {"stringUnit": {"state": "translated", "value": "「%@」を単語帳から削除しますか？"}},
        "ko": {"stringUnit": {"state": "translated", "value": "“%@”을(를) 단어장에서 제거하겠습니까?"}},
        "ru": {"stringUnit": {"state": "translated", "value": "Удалить «%@» из словаря?"}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "要从生词本移除“%@”吗？"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "要從生詞本移除「%@」嗎？"}}
      }
    },
    "Save to Vocabulary": {
      "localizations": {
