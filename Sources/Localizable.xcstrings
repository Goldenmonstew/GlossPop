        "de": {"stringUnit": {"state": "translated", "value": "Wähle einen Eintrag aus, um die vollständig gespeicherte Wörterbuchkarte zu sehen."}},
        "es": {"stringUnit": {"state": "translated", "value": "Selecciona una entrada para ver su ficha de diccionario completa."}},
