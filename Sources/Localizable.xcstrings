    "Vocabulary Unavailable": {
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Wortschatz nicht verfügbar"}},
        "es": {"stringUnit": {"state": "translated", "value": "Vocabulario no disponible"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Vocabulaire indisponible"}},
        "ja": {"stringUnit": {"state": "translated", "value": "単語帳を利用できません"}},
