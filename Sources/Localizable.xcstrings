      }
    },
    "Vocabulary library version %lld is not supported.": {
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Wortschatzversion %lld wird nicht unterstützt."}},
        "es": {"stringUnit": {"state": "translated", "value": "La versión %lld de la biblioteca de vocabulario no es compatible."}},
        "fr": {"stringUnit": {"state": "translated", "value": "La version %lld de la bibliothèque de vocabulaire n’est pas prise en charge."}},
        "ja": {"stringUnit": {"state": "translated", "value": "単語帳のバージョン%lldには対応していません。"}},
        "ko": {"stringUnit": {"state": "translated", "value": "단어장 버전 %lld은(는) 지원되지 않습니다."}},
        "ru": {"stringUnit": {"state": "translated", "value": "Версия словаря %lld не поддерживается."}},
