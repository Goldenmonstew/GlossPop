{
  "sourceLanguage": "en",
  "strings": {
    "AI dictionary": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"KI-Wörterbuch"}},"es":{"stringUnit":{"state":"translated","value":"Diccionario de IA"}},"fr":{"stringUnit":{"state":"translated","value":"Dictionnaire IA"}},"ja":{"stringUnit":{"state":"translated","value":"AI辞書"}},"ko":{"stringUnit":{"state":"translated","value":"AI 사전"}},"ru":{"stringUnit":{"state":"translated","value":"ИИ-словарь"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"AI 词典"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"AI 詞典"}}}},
    "API format": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"API-Format"}},"es":{"stringUnit":{"state":"translated","value":"Formato de API"}},"fr":{"stringUnit":{"state":"translated","value":"Format d’API"}},"ja":{"stringUnit":{"state":"translated","value":"API形式"}},"ko":{"stringUnit":{"state":"translated","value":"API 형식"}},"ru":{"stringUnit":{"state":"translated","value":"Формат API"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"API 格式"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"API 格式"}}}},
    "API key header": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"API-Key-Header"}},"es":{"stringUnit":{"state":"translated","value":"Encabezado de clave de API"}},"fr":{"stringUnit":{"state":"translated","value":"En-tête de clé API"}},"ja":{"stringUnit":{"state":"translated","value":"APIキーヘッダー"}},"ko":{"stringUnit":{"state":"translated","value":"API 키 헤더"}},"ru":{"stringUnit":{"state":"translated","value":"Заголовок API-ключа"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"API Key 请求头"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"API Key 請求標頭"}}}},
    "Automatic (protocol default)": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Automatisch (Protokollstandard)"}},"es":{"stringUnit":{"state":"translated","value":"Automático (predeterminado del protocolo)"}},"fr":{"stringUnit":{"state":"translated","value":"Automatique (valeur par défaut du protocole)"}},"ja":{"stringUnit":{"state":"translated","value":"自動（プロトコルのデフォルト）"}},"ko":{"stringUnit":{"state":"translated","value":"자동(프로토콜 기본값)"}},"ru":{"stringUnit":{"state":"translated","value":"Автоматически (по умолчанию для протокола)"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"自动（协议默认）"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"自動（協定預設）"}}}},
    "No authentication": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Keine Authentifizierung"}},"es":{"stringUnit":{"state":"translated","value":"Sin autenticación"}},"fr":{"stringUnit":{"state":"translated","value":"Aucune authentification"}},"ja":{"stringUnit":{"state":"translated","value":"認証なし"}},"ko":{"stringUnit":{"state":"translated","value":"인증 없음"}},"ru":{"stringUnit":{"state":"translated","value":"Без аутентификации"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"无需认证"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"無需驗證"}}}},
    "Automatic uses Bearer for OpenAI, x-api-key for Anthropic, and no API key for localhost.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Automatisch verwendet Bearer für OpenAI, x-api-key für Anthropic und keinen API-Schlüssel für localhost."}},"es":{"stringUnit":{"state":"translated","value":"Automático usa Bearer para OpenAI, x-api-key para Anthropic y ninguna clave de API para localhost."}},"fr":{"stringUnit":{"state":"translated","value":"Le mode automatique utilise Bearer pour OpenAI, x-api-key pour Anthropic et aucune clé API pour localhost."}},"ja":{"stringUnit":{"state":"translated","value":"自動では、OpenAI に Bearer、Anthropic に x-api-key を使用し、localhost では API キーを使用しません。"}},"ko":{"stringUnit":{"state":"translated","value":"자동은 OpenAI에 Bearer, Anthropic에 x-api-key를 사용하고 localhost에는 API 키를 사용하지 않습니다."}},"ru":{"stringUnit":{"state":"translated","value":"Автоматический режим использует Bearer для OpenAI, x-api-key для Anthropic и не использует API-ключ для localhost."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"自动模式对 OpenAI 使用 Bearer，对 Anthropic 使用 x-api-key，并且 localhost 不使用 API Key。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"自動模式對 OpenAI 使用 Bearer，對 Anthropic 使用 x-api-key，且 localhost 不使用 API Key。"}}}},
    "Anthropic-compatible": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Anthropic-kompatibel"}},"es":{"stringUnit":{"state":"translated","value":"Compatible con Anthropic"}},"fr":{"stringUnit":{"state":"translated","value":"Compatible Anthropic"}},"ja":{"stringUnit":{"state":"translated","value":"Anthropic互換"}},"ko":{"stringUnit":{"state":"translated","value":"Anthropic 호환"}},"ru":{"stringUnit":{"state":"translated","value":"Совместимый с Anthropic"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"Anthropic 兼容"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"Anthropic 相容"}}}},
    "OpenAI-compatible": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"OpenAI-kompatibel"}},"es":{"stringUnit":{"state":"translated","value":"Compatible con OpenAI"}},"fr":{"stringUnit":{"state":"translated","value":"Compatible OpenAI"}},"ja":{"stringUnit":{"state":"translated","value":"OpenAI互換"}},"ko":{"stringUnit":{"state":"translated","value":"OpenAI 호환"}},"ru":{"stringUnit":{"state":"translated","value":"Совместимый с OpenAI"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"OpenAI 兼容"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"OpenAI 相容"}}}},
    "Alibaba Cloud Model Studio's Anthropic endpoint does not provide a model list. Enter the model ID manually.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Der Anthropic-Endpunkt von Alibaba Cloud Model Studio stellt keine Modellliste bereit. Gib die Modell-ID manuell ein."}},"es":{"stringUnit":{"state":"translated","value":"El endpoint Anthropic de Alibaba Cloud Model Studio no proporciona una lista de modelos. Introduce el ID del modelo manualmente."}},"fr":{"stringUnit":{"state":"translated","value":"Le point de terminaison Anthropic d’Alibaba Cloud Model Studio ne fournit pas de liste de modèles. Saisissez l’identifiant du modèle manuellement."}},"ja":{"stringUnit":{"state":"translated","value":"Alibaba Cloud Model Studio の Anthropic エンドポイントはモデル一覧を提供しません。モデル ID を手動で入力してください。"}},"ko":{"stringUnit":{"state":"translated","value":"Alibaba Cloud Model Studio의 Anthropic 엔드포인트는 모델 목록을 제공하지 않습니다. 모델 ID를 직접 입력하세요."}},"ru":{"stringUnit":{"state":"translated","value":"Эндпоинт Anthropic в Alibaba Cloud Model Studio не предоставляет список моделей. Введите идентификатор модели вручную."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"阿里云百炼 Anthropic 端点不提供模型列表，请手动输入模型 ID。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"阿里雲百煉 Anthropic 端點不提供模型列表，請手動輸入模型 ID。"}}}},
    "e.g. claude-haiku-4-5": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"z. B. claude-haiku-4-5"}},"es":{"stringUnit":{"state":"translated","value":"p. ej. claude-haiku-4-5"}},"fr":{"stringUnit":{"state":"translated","value":"ex. claude-haiku-4-5"}},"ja":{"stringUnit":{"state":"translated","value":"例: claude-haiku-4-5"}},"ko":{"stringUnit":{"state":"translated","value":"예: claude-haiku-4-5"}},"ru":{"stringUnit":{"state":"translated","value":"напр. claude-haiku-4-5"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"例如 claude-haiku-4-5"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"例如 claude-haiku-4-5"}}}},
    "Check compatibility": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Kompatibilität prüfen"}},"es":{"stringUnit":{"state":"translated","value":"Comprobar compatibilidad"}},"fr":{"stringUnit":{"state":"translated","value":"Vérifier la compatibilité"}},"ja":{"stringUnit":{"state":"translated","value":"互換性を確認"}},"ko":{"stringUnit":{"state":"translated","value":"호환성 확인"}},"ru":{"stringUnit":{"state":"translated","value":"Проверить совместимость"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"检查兼容性"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"檢查相容性"}}}},
    "Couldn't assess": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Prüfung nicht möglich"}},"es":{"stringUnit":{"state":"translated","value":"No se pudo evaluar"}},"fr":{"stringUnit":{"state":"translated","value":"Évaluation impossible"}},"ja":{"stringUnit":{"state":"translated","value":"評価できませんでした"}},"ko":{"stringUnit":{"state":"translated","value":"평가할 수 없음"}},"ru":{"stringUnit":{"state":"translated","value":"Не удалось выполнить проверку"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"无法完成检查"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"無法完成檢查"}}}},
    "Couldn't complete the compatibility check: %@": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Die Kompatibilitätsprüfung konnte nicht abgeschlossen werden: %@"}},"es":{"stringUnit":{"state":"translated","value":"No se pudo completar la comprobación de compatibilidad: %@"}},"fr":{"stringUnit":{"state":"translated","value":"Impossible de terminer la vérification de compatibilité : %@"}},"ja":{"stringUnit":{"state":"translated","value":"互換性の確認を完了できませんでした: %@"}},"ko":{"stringUnit":{"state":"translated","value":"호환성 확인을 완료하지 못했습니다: %@"}},"ru":{"stringUnit":{"state":"translated","value":"Не удалось завершить проверку совместимости: %@"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"无法完成兼容性检查：%@"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"無法完成相容性檢查：%@"}}}},
    "First time with this cloud service: “Check compatibility” sends built-in test text to %@ and confirms that future selections may be sent there for translation.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Bei der ersten Nutzung dieses Cloud-Dienstes sendet „Kompatibilität prüfen“ integrierte Testtexte an %@ und bestätigt, dass künftig ausgewählte Texte zur Übersetzung dorthin gesendet werden dürfen."}},"es":{"stringUnit":{"state":"translated","value":"La primera vez que uses este servicio en la nube, «Comprobar compatibilidad» enviará texto de prueba integrado a %@ y confirmará que las futuras selecciones pueden enviarse allí para traducirlas."}},"fr":{"stringUnit":{"state":"translated","value":"Lors de la première utilisation de ce service cloud, « Vérifier la compatibilité » envoie un texte de test intégré à %@ et confirme que les futures sélections pourront y être envoyées pour traduction."}},"ja":{"stringUnit":{"state":"translated","value":"このクラウドサービスの初回利用時、「互換性を確認」は内蔵テスト文を %@ に送信し、今後選択したテキストを翻訳のために送信できることを確認します。"}},"ko":{"stringUnit":{"state":"translated","value":"이 클라우드 서비스를 처음 사용할 때 ‘호환성 확인’은 내장 테스트 문구를 %@(으)로 전송하며, 앞으로 선택한 텍스트를 번역을 위해 해당 서비스로 보낼 수 있음에 동의합니다."}},"ru":{"stringUnit":{"state":"translated","value":"При первом использовании этого облачного сервиса функция «Проверить совместимость» отправит встроенный тестовый текст на %@ и подтвердит, что в дальнейшем туда можно отправлять выделенный текст для перевода."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"首次使用该云服务时，「检查兼容性」会将内置测试文本发送至 %@，并确认今后可将选中文本发送到该服务进行翻译。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"首次使用此雲端服務時，「檢查相容性」會將內建測試文字傳送至 %@，並確認日後可將選取的文字傳送到該服務進行翻譯。"}}}},
    "Fully compatible": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Vollständig kompatibel"}},"es":{"stringUnit":{"state":"translated","value":"Totalmente compatible"}},"fr":{"stringUnit":{"state":"translated","value":"Entièrement compatible"}},"ja":{"stringUnit":{"state":"translated","value":"完全互換"}},"ko":{"stringUnit":{"state":"translated","value":"완전 호환"}},"ru":{"stringUnit":{"state":"translated","value":"Полная совместимость"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"完全兼容"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"完全相容"}}}},
    "Not compatible": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Nicht kompatibel"}},"es":{"stringUnit":{"state":"translated","value":"No compatible"}},"fr":{"stringUnit":{"state":"translated","value":"Non compatible"}},"ja":{"stringUnit":{"state":"translated","value":"互換性なし"}},"ko":{"stringUnit":{"state":"translated","value":"호환되지 않음"}},"ru":{"stringUnit":{"state":"translated","value":"Несовместимо"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"不兼容"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"不相容"}}}},
    "Not run": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Nicht ausgeführt"}},"es":{"stringUnit":{"state":"translated","value":"No ejecutado"}},"fr":{"stringUnit":{"state":"translated","value":"Non exécuté"}},"ja":{"stringUnit":{"state":"translated","value":"未実行"}},"ko":{"stringUnit":{"state":"translated","value":"실행되지 않음"}},"ru":{"stringUnit":{"state":"translated","value":"Не выполнено"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"未运行"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"未執行"}}}},
    "Sentence analysis": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Satzanalyse"}},"es":{"stringUnit":{"state":"translated","value":"Análisis de oraciones"}},"fr":{"stringUnit":{"state":"translated","value":"Analyse de phrase"}},"ja":{"stringUnit":{"state":"translated","value":"文解析"}},"ko":{"stringUnit":{"state":"translated","value":"문장 분석"}},"ru":{"stringUnit":{"state":"translated","value":"Анализ предложения"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"句子解析"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"句子解析"}}}},
    "Streaming translation": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Streaming-Übersetzung"}},"es":{"stringUnit":{"state":"translated","value":"Traducción en streaming"}},"fr":{"stringUnit":{"state":"translated","value":"Traduction en continu"}},"ja":{"stringUnit":{"state":"translated","value":"ストリーミング翻訳"}},"ko":{"stringUnit":{"state":"translated","value":"스트리밍 번역"}},"ru":{"stringUnit":{"state":"translated","value":"Потоковый перевод"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"流式翻译"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"串流翻譯"}}}},
    "Testing sentence analysis…": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Satzanalyse wird geprüft…"}},"es":{"stringUnit":{"state":"translated","value":"Probando el análisis de oraciones…"}},"fr":{"stringUnit":{"state":"translated","value":"Test de l’analyse de phrase…"}},"ja":{"stringUnit":{"state":"translated","value":"文解析をテスト中…"}},"ko":{"stringUnit":{"state":"translated","value":"문장 분석 테스트 중…"}},"ru":{"stringUnit":{"state":"translated","value":"Проверка анализа предложения…"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"正在测试句子解析…"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"正在測試句子解析…"}}}},
    "Testing the AI dictionary…": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"KI-Wörterbuch wird geprüft…"}},"es":{"stringUnit":{"state":"translated","value":"Probando el diccionario de IA…"}},"fr":{"stringUnit":{"state":"translated","value":"Test du dictionnaire IA…"}},"ja":{"stringUnit":{"state":"translated","value":"AI辞書をテスト中…"}},"ko":{"stringUnit":{"state":"translated","value":"AI 사전 테스트 중…"}},"ru":{"stringUnit":{"state":"translated","value":"Проверка ИИ-словаря…"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"正在测试 AI 词典…"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"正在測試 AI 詞典…"}}}},
    "Testing translation…": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Übersetzung wird geprüft…"}},"es":{"stringUnit":{"state":"translated","value":"Probando la traducción…"}},"fr":{"stringUnit":{"state":"translated","value":"Test de la traduction…"}},"ja":{"stringUnit":{"state":"translated","value":"翻訳をテスト中…"}},"ko":{"stringUnit":{"state":"translated","value":"번역 테스트 중…"}},"ru":{"stringUnit":{"state":"translated","value":"Проверка перевода…"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"正在测试翻译…"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"正在測試翻譯…"}}}},
    "The AI dictionary result was incomplete.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Das Ergebnis des KI-Wörterbuchs war unvollständig."}},"es":{"stringUnit":{"state":"translated","value":"El resultado del diccionario de IA estaba incompleto."}},"fr":{"stringUnit":{"state":"translated","value":"Le résultat du dictionnaire IA était incomplet."}},"ja":{"stringUnit":{"state":"translated","value":"AI辞書の結果が不完全でした。"}},"ko":{"stringUnit":{"state":"translated","value":"AI 사전 결과가 불완전합니다."}},"ru":{"stringUnit":{"state":"translated","value":"Результат ИИ-словаря оказался неполным."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"AI 词典结果不完整。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"AI 詞典結果不完整。"}}}},
    "The check uses built-in sample text and built-in prompts; custom prompts are not sent or evaluated. It tests streamed translation, the AI dictionary and sentence analysis, and never reads your selection, clipboard, history or vocabulary.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Die Prüfung verwendet integrierte Beispieltexte und integrierte Prompts; eigene Prompts werden weder gesendet noch ausgewertet. Sie testet Streaming-Übersetzung, KI-Wörterbuch und Satzanalyse und liest niemals deine Auswahl, Zwischenablage, deinen Verlauf oder Wortschatz."}},"es":{"stringUnit":{"state":"translated","value":"La comprobación usa texto de ejemplo y prompts integrados; los prompts personalizados no se envían ni se evalúan. Prueba la traducción en streaming, el diccionario de IA y el análisis de oraciones, y nunca lee tu selección, portapapeles, historial ni vocabulario."}},"fr":{"stringUnit":{"state":"translated","value":"La vérification utilise des textes d’exemple et des prompts intégrés ; les prompts personnalisés ne sont ni envoyés ni évalués. Elle teste la traduction en continu, le dictionnaire IA et l’analyse de phrase, sans jamais lire votre sélection, votre presse-papiers, votre historique ni votre vocabulaire."}},"ja":{"stringUnit":{"state":"translated","value":"確認には内蔵のサンプル文と内蔵プロンプトを使用し、カスタムプロンプトは送信も評価もしません。ストリーミング翻訳、AI辞書、文解析をテストしますが、選択テキスト、クリップボード、履歴、単語帳は一切読み取りません。"}},"ko":{"stringUnit":{"state":"translated","value":"확인에는 내장 샘플 텍스트와 내장 프롬프트만 사용되며, 사용자 지정 프롬프트는 전송하거나 평가하지 않습니다. 스트리밍 번역, AI 사전 및 문장 분석을 테스트하며 선택 영역, 클립보드, 기록 또는 단어장은 절대 읽지 않습니다."}},"ru":{"stringUnit":{"state":"translated","value":"Для проверки используются встроенные примеры текста и встроенные промпты; пользовательские промпты не отправляются и не оцениваются. Проверяются потоковый перевод, ИИ-словарь и анализ предложений; выделенный текст, буфер обмена, история и словарь никогда не читаются."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"检查仅使用内置样例文本和内置提示词；自定义提示词不会被发送或评估。检查会测试流式翻译、AI 词典和句子解析，且绝不会读取你的选区、剪贴板、历史记录或生词本。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"檢查僅使用內建範例文字和內建提示詞；自訂提示詞不會被傳送或評估。檢查會測試串流翻譯、AI 詞典和句子解析，且絕不會讀取你的選取範圍、剪貼簿、歷史記錄或生詞本。"}}}},
    "The model returned no streamed translation.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Das Modell hat keine Streaming-Übersetzung zurückgegeben."}},"es":{"stringUnit":{"state":"translated","value":"El modelo no devolvió ninguna traducción en streaming."}},"fr":{"stringUnit":{"state":"translated","value":"Le modèle n’a renvoyé aucune traduction en continu."}},"ja":{"stringUnit":{"state":"translated","value":"モデルからストリーミング翻訳が返されませんでした。"}},"ko":{"stringUnit":{"state":"translated","value":"모델이 스트리밍 번역을 반환하지 않았습니다."}},"ru":{"stringUnit":{"state":"translated","value":"Модель не вернула потоковый перевод."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"模型未返回流式翻译。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"模型未傳回串流翻譯。"}}}},
    "The result language couldn't be confirmed as %@.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Die Ergebnissprache konnte nicht als %@ bestätigt werden."}},"es":{"stringUnit":{"state":"translated","value":"No se pudo confirmar que el resultado estuviera en %@."}},"fr":{"stringUnit":{"state":"translated","value":"Impossible de confirmer que le résultat est en %@."}},"ja":{"stringUnit":{"state":"translated","value":"結果の言語が%@であることを確認できませんでした。"}},"ko":{"stringUnit":{"state":"translated","value":"결과 언어가 %@(으)로 작성되었는지 확인할 수 없습니다."}},"ru":{"stringUnit":{"state":"translated","value":"Не удалось подтвердить, что результат написан на языке %@."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"无法确认结果语言是否为 %@。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"無法確認結果語言是否為 %@。"}}}},
    "The result was not written in %@.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Das Ergebnis wurde nicht auf %@ verfasst."}},"es":{"stringUnit":{"state":"translated","value":"El resultado no se escribió en %@."}},"fr":{"stringUnit":{"state":"translated","value":"Le résultat n’est pas rédigé en %@."}},"ja":{"stringUnit":{"state":"translated","value":"結果が%@で書かれていません。"}},"ko":{"stringUnit":{"state":"translated","value":"결과가 %@(으)로 작성되지 않았습니다."}},"ru":{"stringUnit":{"state":"translated","value":"Результат написан не на языке %@."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"结果未使用 %@ 书写。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"結果未使用 %@ 書寫。"}}}},
    "The sentence check has no built-in sample for %@.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Für die Satzprüfung ist kein integrierter Beispieltext für %@ verfügbar."}},"es":{"stringUnit":{"state":"translated","value":"La prueba de oraciones no tiene un texto de ejemplo integrado para %@."}},"fr":{"stringUnit":{"state":"translated","value":"Le test de phrase ne dispose d’aucun texte d’exemple intégré pour %@."}},"ja":{"stringUnit":{"state":"translated","value":"文解析の確認には、%@ の内蔵サンプル文がありません。"}},"ko":{"stringUnit":{"state":"translated","value":"문장 분석 확인에 사용할 %@ 내장 샘플 텍스트가 없습니다."}},"ru":{"stringUnit":{"state":"translated","value":"Для проверки анализа предложений нет встроенного примера на языке %@."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"句子解析检查没有 %@ 的内置样例文本。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"句子解析檢查沒有 %@ 的內建範例文字。"}}}},
    "The sentence analysis result was incomplete.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Das Ergebnis der Satzanalyse war unvollständig."}},"es":{"stringUnit":{"state":"translated","value":"El resultado del análisis de oraciones estaba incompleto."}},"fr":{"stringUnit":{"state":"translated","value":"Le résultat de l’analyse de phrase était incomplet."}},"ja":{"stringUnit":{"state":"translated","value":"文解析の結果が不完全でした。"}},"ko":{"stringUnit":{"state":"translated","value":"문장 분석 결과가 불완전합니다."}},"ru":{"stringUnit":{"state":"translated","value":"Результат анализа предложения оказался неполным."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"句子解析结果不完整。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"句子解析結果不完整。"}}}},
