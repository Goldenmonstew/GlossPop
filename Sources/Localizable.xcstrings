        "zh-Hant": {"stringUnit": {"state": "translated", "value": "不支援生詞本版本 %lld。"}}
      }
    },
    "“%@” isn't in the system dictionary.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
