          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” no está en el diccionario del sistema."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« %@ » ne figure pas dans le dictionnaire système."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」はシステム辞書にありません。"
          }
        },
